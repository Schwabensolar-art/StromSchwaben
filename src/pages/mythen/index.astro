---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const mythen = (await getCollection('mythen')).sort((a, b) => +b.data.veroeffentlicht - +a.data.veroeffentlicht);
const klasse = { falsch: 'urteil-falsch', 'teilweise richtig': 'urteil-teilweise', richtig: 'urteil-richtig' } as const;
---
<Base title="Mythen-Check: Was stimmt wirklich?" description="Verbreitete Behauptungen zu Solar, Heizung und Strom im Faktencheck. Mit klarem Urteil und Quellen: falsch, teilweise richtig oder richtig." aktiv="mythen">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Mythen-Check</p>
      <h1 class="page">Was stimmt wirklich?</h1>
      <p class="lead">Behauptungen, die wir in Beratungsgesprächen, Kommentarspalten und Werbung immer wieder hören. Jede mit klarem Urteil und Quellen.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="grid">
        {mythen.map((m) => (
          <a class="card" href={`/mythen/${m.id}/`}>
            <span class={`urteil ${klasse[m.data.urteil]}`}>{m.data.urteil}</span>
            <h3>„{m.data.mythos}“</h3>
            <p>{m.data.kurz}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
