---
import type { CollectionEntry } from 'astro:content';
import MythosIllu from './MythosIllu.astro';

interface Props { m: CollectionEntry<'mythen'> }
const { m } = Astro.props;
const d = m.data;
const klasse = { falsch: 'falsch', 'teilweise richtig': 'teilweise', richtig: 'richtig' } as const;
---
<details class={`mythos mythos-${klasse[d.urteil]}`} data-urteil={klasse[d.urteil]}>
  <summary>
    <div class="mythos-bild"><MythosIllu motiv={d.illustration} titel={`Illustration: ${d.mythos}`} /></div>
    <span class="mythos-label">Mythos</span>
    <h3>„{d.mythos}“</h3>
    <span class="mythos-hinweis"><span class="mythos-plus" aria-hidden="true"></span><span class="zu">Stimmt das?</span><span class="auf">Zuklappen</span></span>
  </summary>
  <div class="mythos-antwort">
    <span class={`urteil urteil-${klasse[d.urteil]}`}>Urteil: {d.urteil}</span>
    <p>{d.kurz}</p>
    <a class="mythos-link" href={`/mythen/${m.id}/`}>Ganzer Faktencheck mit Quellen</a>
  </div>
</details>

<style>
  .mythos{border:1px solid var(--border);border-radius:12px;background:var(--white);overflow:hidden;transition:border-color .2s,box-shadow .2s,transform .2s}
  .mythos:hover{border-color:#bbb;transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.06)}
  .mythos[open]{border-color:var(--black);transform:none;box-shadow:0 6px 24px rgba(0,0,0,.08)}
  summary{list-style:none;cursor:pointer;padding:20px 22px 18px;display:flex;flex-direction:column;gap:8px}
  summary::-webkit-details-marker{display:none}
  .mythos-bild{background:var(--bg);border-radius:8px;margin:-4px -6px 8px;padding:8px 24px}
  .mythos-label{font-size:.68rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  h3{font-size:1.12rem;font-weight:700;letter-spacing:-.02em;line-height:1.3}
  .mythos-hinweis{display:inline-flex;align-items:center;gap:8px;margin-top:6px;font-size:.84rem;font-weight:700}
  .mythos-plus{position:relative;width:22px;height:22px;border-radius:50%;background:var(--black);flex-shrink:0;transition:transform .25s}
  .mythos-plus::before,.mythos-plus::after{content:'';position:absolute;left:50%;top:50%;width:10px;height:2px;background:var(--white);transform:translate(-50%,-50%)}
  .mythos-plus::after{transform:translate(-50%,-50%) rotate(90deg)}
  .mythos[open] .mythos-plus{transform:rotate(45deg)}
  .auf{display:none}
  .mythos[open] .zu{display:none}
  .mythos[open] .auf{display:inline}
  .mythos-antwort{padding:18px 22px 22px;border-top:4px solid var(--border);animation:auf .3s ease}
  .mythos-falsch .mythos-antwort{border-top-color:var(--bad);background:linear-gradient(var(--bad-bg),var(--white) 70%)}
  .mythos-teilweise .mythos-antwort{border-top-color:var(--warn);background:linear-gradient(var(--warn-bg),var(--white) 70%)}
  .mythos-richtig .mythos-antwort{border-top-color:var(--ok);background:linear-gradient(var(--ok-bg),var(--white) 70%)}
  .mythos-antwort .urteil{font-size:.8rem}
  .mythos-antwort p{margin:12px 0 14px;font-size:.93rem;line-height:1.65;color:#333}
  .mythos-link{font-size:.84rem;font-weight:700;text-decoration:underline;text-decoration-color:var(--sun);text-decoration-thickness:2px;text-underline-offset:3px}
  @keyframes auf{from{transform:translateY(-8px)}to{transform:none}}
  .mythos-bild :global(svg){max-height:180px;margin:0 auto}
  @media (max-width:640px){.mythos-bild :global(svg){max-height:150px}}
  @media (prefers-reduced-motion:reduce){.mythos,.mythos-plus,.mythos-antwort{transition:none;animation:none}}
</style>
